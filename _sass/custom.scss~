/* =========================================================
   PAINTING PAGE
   ========================================================= */

.painting img {
  display: block;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}


/* =========================================================
   PAINTING GALLERIES
   ========================================================= */

.painting-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 2.5rem;
}

.painting-card {
  display: flex;
  flex-direction: column;

  text-decoration: none;
  color: inherit;

  padding: 1rem;

  background: #fff;
  border: 1px solid #d9d9d9;
  border-radius: 4px;

  transition: all .18s ease;
}

.painting-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 10px rgba(0,0,0,.08);
}

.painting-card img {
  display: block;

  width: 100%;
  height: 300px;

  object-fit: contain;

  margin: 0;
  padding: 0;

  border: none;
  outline: none;
  box-shadow: none;
}

.painting-card h3 {
  margin: 1rem 0 .25rem;
  padding-top: 1rem;

  border-top: 1px solid #ececec;

  text-align: center;
  font-weight: 400;
}

.painting-year {
  margin: 0;
  text-align: center;
  color: #777;
  font-size: .9rem;
  font-style: italic;
}


.painting-year {
  margin: 0 0 1rem;

  color: #777;
  text-align: center;
  font-size: .9rem;
  font-style: italic;
}


/* =========================================================
   CATEGORY CARDS (HOME PAGE)
   ========================================================= */

.gallery-categories {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
  margin: 2rem 0;
}

.category-card {
  display: flex;
  flex-direction: column;

  text-decoration: none;
  color: inherit;

  padding: 1rem;

  background: #fff;
  border: 1px solid #d9d9d9;
  border-radius: 4px;

  transition: all .18s ease;
}

.category-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 10px rgba(0,0,0,.08);
}

.category-card img {
  display: block;

  width: 100%;
  height: 220px;

  object-fit: contain;

  margin: 0;
  padding: 0;

  border: none;
  outline: none;
  box-shadow: none;
}

.category-card h2 {
  margin: 1rem 0 0;
  padding-top: 1rem;

  border-top: 1px solid #ececec;

  text-align: center;
  font-weight: 400;
}


/* =========================================================
   TYPOGRAPHY
   ========================================================= */

.page__title {
  font-size: 2.4rem;
  font-weight: 300;
  margin-bottom: 1rem;
}

.page__content {
  font-size: 1.1rem;
  line-height: 1.8;
}


/* =========================================================
   LAYOUT
   ========================================================= */

.page,
.archive {
  max-width: 1500px;
}


/* =========================================================
   PREVIOUS / NEXT NAVIGATION
   ========================================================= */

.painting-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 3rem 0;
}

.painting-nav a {
  text-decoration: none;
}

.painting-nav a:hover {
  text-decoration: underline;
}


a img:hover,
a:hover img {
    box-shadow: none !important;
    border: none !important;
    transform: none !important;
}