/* Gallery */

.painting-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

.painting-card {
  text-align: center;
}

.painting-card img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  display: block;
  transition: transform .25s ease;
}

.painting-card img:hover {
  transform: scale(1.02);
}

.painting-card h3 {
  margin-top: 0.75rem;
  font-weight: 400;
}

/* Painting page */

.painting img {
  width: 100%;
  max-width: 1100px;
  display: block;
  margin: auto;
}


/* Typography */

.page__title {
  font-size: 2.4rem;
  font-weight: 300;
  margin-bottom: 1rem;
}

.page__content {
  font-size: 1.1rem;
  line-height: 1.8;
}


/* Wider content area */

.page {
  max-width: 1500px;
}

.archive {
  max-width: 1500px;
}